            <text x="115" y="120" text-anchor="middle" font-size="11" font-style="italic" fill="var(--green)">det · 1</text>
            <path d="M170,158 C170,116 280,116 280,158" fill="none" stroke="var(--green)" stroke-width="1.8" marker-end="url(#arwA)"/>
            <text x="225" y="120" text-anchor="middle" font-size="11" font-style="italic" fill="var(--green)">nsubj · 1</text>
            <path d="M390,158 C390,96 610,96 610,158" fill="none" stroke="var(--green)" stroke-width="1.8" marker-end="url(#arwA)"/>
            <text x="500" y="105" text-anchor="middle" font-size="11" font-style="italic" fill="var(--green)">case · 2</text>
