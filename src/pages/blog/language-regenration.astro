---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../data/blog';
import { SITE, absoluteUrl, personId, websiteId } from '../../data/site';

const article = blogPosts.find((post) => post.slug === 'language-regenration');

if (!article) {
  throw new Error('Missing blog metadata for the Language Re-generation article.');
}

const articleUrl = absoluteUrl(article.href);
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.description,
  datePublished: article.publishedOn,
  dateModified: article.updatedOn ?? article.publishedOn,
  image: absoluteUrl(SITE.defaultImage),
  author: [
    { '@type': 'Person', '@id': personId(), name: SITE.author.name },
    { '@type': 'Person', name: 'Laurence E. Frank' },
    { '@type': 'Person', name: 'Albert Gatt' },
    { '@type': 'Person', name: 'Ayoub Bagheri' },
  ],
  publisher: {
    '@id': personId(),
  },
  isPartOf: {
    '@id': websiteId(),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  url: articleUrl,
  keywords: article.tags.join(', '),
};
---

<BaseLayout
    title={`${article.title} — Amirhossein Mohammadi`}
    description={article.description}
    canonicalPath={article.href}
    pageType="article"
    publishedTime={article.publishedOn}
    modifiedTime={article.updatedOn ?? article.publishedOn}
    htmlClass="scroll-smooth"
>
  <Fragment slot="head">
    <script
        type="application/ld+json"
        set:html={JSON.stringify(articleStructuredData)}
    ></script>
  </Fragment>

  <style is:global>
    :root {
      --ink: #111;
      --ink-mid: #444;
      --ink-light: #777;
      --ink-faint: #aaa;
      --bg: #fff;
      --bg-subtle: #f9f9f9;
      --rule: #e4e4e4;
      --accent: #2a5caa;
      --accent-light: #e8eef8;
      --green: #2e7d32;
      --green-light: #e8f4e8;
      --red: #c0392b;
      --red-light: #fff5f5;
      --orange: #e65100;
      --orange-light: #fff3e0;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-padding-top: 3.5rem; }

    body {
      font-family: 'Source Sans 3', sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--rule);
    }
    .nav-inner {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 3rem;
    }
    .nav-name {
      font-family: 'EB Garamond', serif;
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--ink);
      text-decoration: none;
    }
    .nav-links {
      display: flex;
      gap: 0.1rem;
    }
    .nav-links a {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--ink-light);
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 3px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: color 0.15s, background 0.15s;
    }
    .nav-links a:hover {
      color: var(--ink);
      background: var(--bg-subtle);
    }
    .nav-links a.active {
      color: var(--accent);
    }
    .mobile-toggle {
      display: none;
      background: none;
      border: none;
      font-size: 1.1rem;
      color: var(--ink-light);
      cursor: pointer;
      padding: 0.4rem;
    }
    .mobile-nav {
      display: none;
      border-bottom: 1px solid var(--rule);
      padding: 0.5rem 1.5rem 0.75rem;
    }
    .mobile-nav.open {
      display: block;
    }
    .mobile-nav a {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--ink-light);
      text-decoration: none;
      padding: 0.4rem 0;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .mobile-nav a:hover {
      color: var(--ink);
    }
    @media (max-width: 640px) {
      .nav-links { display: none; }
      .mobile-toggle { display: block; }
    }

    .page {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .article-header {
      padding: 3rem 0 2rem;
      border-bottom: 1px solid var(--rule);
    }
    .article-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.77rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-faint);
      text-decoration: none;
      margin-bottom: 1.75rem;
      transition: color 0.15s;
    }
    .article-back:hover {
      color: var(--accent);
    }
    .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.1rem;
    }
    .article-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      color: var(--ink-light);
      background: #f0f0f0;
      padding: 0.15rem 0.5rem;
      border-radius: 2px;
    }
    .article-tag.hl {
      background: var(--accent-light);
      color: var(--accent);
    }
    .article-tag.tut {
      background: var(--orange-light);
      color: var(--orange);
    }
    .article-header h1 {
      font-family: 'EB Garamond', serif;
      font-size: 2.05rem;
      font-weight: 500;
      line-height: 1.2;
      color: var(--ink);
      margin-bottom: 0.55rem;
    }
    .article-header .subtitle {
      font-family: 'EB Garamond', serif;
      font-size: 1.1rem;
      font-style: italic;
      color: var(--ink-light);
      margin-bottom: 0.9rem;
    }
    .article-meta {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      flex-wrap: wrap;
      font-size: 0.82rem;
      color: var(--ink-faint);
      margin-bottom: 1.25rem;
    }
    .article-meta .date {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
    }
    .article-meta .authors {
      font-family: 'EB Garamond', serif;
      font-size: 0.95rem;
      color: var(--ink-mid);
      font-style: italic;
    }
    .article-meta .sep { color: var(--rule); }

    .article-links {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .article-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-light);
      text-decoration: none;
      padding: 0.3rem 0.7rem;
      border: 1px solid var(--rule);
      border-radius: 4px;
      transition: all 0.15s;
    }
    .article-link:hover {
      color: var(--accent);
      border-color: var(--accent);
      background: var(--accent-light);
    }

    .toc {
      background: var(--bg-subtle);
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 1.1rem 1.3rem;
      margin: 2rem 0;
    }
    .toc-title {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--ink-faint);
      margin-bottom: 0.7rem;
    }
    .toc ol {
      padding-left: 1.3rem;
      margin: 0;
    }
    .toc li {
      font-family: 'EB Garamond', serif;
      font-size: 1rem;
      color: var(--ink-mid);
      margin-bottom: 0.25rem;
      line-height: 1.5;
    }
    .toc a {
      color: var(--ink-mid);
      text-decoration: none;
      transition: color 0.15s;
    }
    .toc a:hover {
      color: var(--accent);
    }

    .article-body {
      padding: 2.25rem 0;
    }
    .article-body p {
      font-family: 'EB Garamond', serif;
      font-size: 1.07rem;
      line-height: 1.87;
      color: var(--ink-mid);
      margin-bottom: 1.1rem;
      text-align: justify;
      hyphens: auto;
    }
    .article-body p:last-child { margin-bottom: 0; }
    .article-body h2 {
      font-family: 'EB Garamond', serif;
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--ink);
      margin: 2.75rem 0 0.9rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--rule);
    }
    .article-body h2:first-child {
      margin-top: 0;
      border-top: none;
    }
    .article-body h2 .step-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      background: var(--accent);
      color: #fff;
      border-radius: 3px;
      padding: 0.15rem 0.45rem;
      margin-right: 0.6rem;
      vertical-align: middle;
      position: relative;
      top: -2px;
    }
    .article-body h3 {
      font-family: 'EB Garamond', serif;
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--ink);
      margin: 1.75rem 0 0.55rem;
    }
    .article-body a {
      color: var(--ink);
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-color: var(--rule);
      transition: color 0.15s, text-decoration-color 0.15s;
    }
    .article-body a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }
    .article-body strong { color: var(--ink); }

    code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85em;
      background: #f0f0f0;
      color: var(--ink-mid);
      padding: 0.1em 0.35em;
      border-radius: 3px;
    }

    .callout {
      border-radius: 0 6px 6px 0;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .callout.info { background: var(--accent-light); border-left: 3px solid var(--accent); }
    .callout.tip { background: var(--green-light); border-left: 3px solid var(--green); }
    .callout.warn { background: var(--orange-light); border-left: 3px solid var(--orange); }
    .callout-label {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.4rem;
    }
    .callout.info .callout-label { color: var(--accent); }
    .callout.tip .callout-label { color: var(--green); }
    .callout.warn .callout-label { color: var(--orange); }
    .callout p {
      font-size: 1rem !important;
      margin-bottom: 0 !important;
      color: var(--ink-mid);
    }

    .demo-sentence {
      background: var(--bg-subtle);
      border: 1px solid var(--rule);
      border-radius: 8px;
      padding: 1.1rem 1.2rem;
      margin: 1.1rem 0;
      font-family: 'EB Garamond', serif;
    }
    .demo-label {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      margin-bottom: 0.5rem;
    }
    .demo-label.natural { color: var(--green); }
    .demo-label.perturbed { color: var(--red); }
    .demo-label.recovered { color: var(--accent); }
    .demo-text {
      font-size: 1.12rem;
      color: var(--ink);
      line-height: 1.6;
    }
    .demo-text .tok-r {
      display: inline-block;
      background: #ffe0e0;
      color: var(--red);
      border-radius: 3px;
      padding: 0 0.3rem;
      font-size: 0.9em;
      font-family: 'JetBrains Mono', monospace;
    }
    .demo-text .tok-s {
      display: inline-block;
      background: #ddeeff;
      color: #1a5276;
      border-radius: 3px;
      padding: 0 0.3rem;
      font-size: 0.9em;
      font-family: 'JetBrains Mono', monospace;
    }
    .demo-text .perturbed-word {
      background: #fff3cd;
      border-radius: 2px;
      padding: 0 0.1rem;
      color: #7d5a00;
    }
    .demo-arrow {
      text-align: center;
      font-size: 1.2rem;
      color: var(--ink-faint);
      margin: 0.2rem 0;
      user-select: none;
    }

    .figure-shell {
      background: linear-gradient(180deg, #fcfcfd 0%, #f7f8fb 100%);
      border: 1px solid var(--rule);
      border-radius: 10px;
      padding: 1.15rem 1.25rem;
      margin: 1.5rem 0;
    }
    .figure-caption {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-faint);
      margin-bottom: 0.85rem;
    }

    .dependency-grid,
    .locality-ladder,
    .diagnostic-grid,
    .dep-explainer {
      display: grid;
      gap: 0.85rem;
    }
    .dependency-grid {
      grid-template-columns: 1fr;
    }
    .diagnostic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .locality-ladder,
    .dep-explainer {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .dependency-card,
    .dep-explainer-card,
    .ladder-card,
    .diagnostic-panel {
      border: 1px solid var(--rule);
      border-radius: 8px;
      background: #fff;
      padding: 0.95rem 1rem;
    }
    .dependency-card.good {
      background: linear-gradient(180deg, #fbfefb 0%, #f3faf4 100%);
      border-color: #d3e5d5;
    }
    .dependency-card.bad {
      background: linear-gradient(180deg, #fffdfd 0%, #fff6f6 100%);
      border-color: #edd2d2;
    }
    .dependency-card h3,
    .ladder-card strong {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.94rem;
      color: var(--ink);
      display: block;
      margin-bottom: 0.35rem;
    }
    .dependency-card p,
    .dep-explainer-card p,
    .ladder-card p {
      margin: 0;
      font-family: 'EB Garamond', serif;
      font-size: 0.98rem;
      line-height: 1.55;
      color: var(--ink-mid);
    }
    .dep-explainer-card span,
    .ladder-card span,
    .diagnostic-panel span {
      display: block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0.35rem;
    }
    .dependency-sentence {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin: 0.8rem 0;
    }
    .dep-word {
      border-radius: 999px;
      padding: 0.32rem 0.58rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.76rem;
      border: 1px solid var(--rule);
      background: #fff;
      color: var(--ink-mid);
    }
    .dep-word.head {
      background: var(--accent-light);
      color: var(--accent);
      border-color: #c9d7ef;
      font-weight: 700;
    }
    .dep-link-list {
      display: grid;
      gap: 0.5rem;
    }
    .dep-link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
      align-items: center;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.88rem;
      color: var(--ink-mid);
    }
    .dep-distance {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.69rem;
      padding: 0.22rem 0.45rem;
      border-radius: 999px;
      white-space: nowrap;
    }
    .dep-distance.short {
      background: #e8f4e8;
      color: var(--green);
    }
    .dep-distance.long {
      background: #fff0f0;
      color: var(--red);
    }

    .table-wrap {
      overflow-x: auto;
      margin: 1.35rem 0;
    }
    .compare-table,
    .heatmap-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid var(--rule);
      border-radius: 8px;
      overflow: hidden;
    }
    .compare-table th,
    .compare-table td,
    .heatmap-table th,
    .heatmap-table td {
      padding: 0.55rem 0.55rem;
      border-bottom: 1px solid #efefef;
      vertical-align: top;
      overflow-wrap: break-word;
    }
    .compare-table th,
    .heatmap-table th {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--ink-light);
      background: var(--bg-subtle);
      text-align: left;
    }
    .compare-table td,
    .heatmap-table td {
      font-family: 'EB Garamond', serif;
      font-size: 0.94rem;
      color: var(--ink-mid);
      line-height: 1.45;
      background: #fff;
    }
    .compare-table tr:last-child td,
    .heatmap-table tr:last-child td {
      border-bottom: none;
    }
    .compare-table .label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--ink-light);
      white-space: normal;
      overflow-wrap: break-word;
      font-weight: 500;
    }
    .compare-table .good {
      color: var(--green);
      font-weight: 700;
    }

    .results-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
      border-radius: 8px;
      overflow: hidden;
      margin: 1.5rem 0;
    }
    .result-card {
      background: #fff;
      padding: 1.1rem 0.95rem;
      text-align: center;
    }
    .result-card .rc-pert {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.35rem;
    }
    .result-card .rc-val {
      font-family: 'EB Garamond', serif;
      font-size: 2.05rem;
      font-weight: 500;
      line-height: 1;
    }
    .result-card .rc-metric {
      font-size: 0.72rem;
      color: var(--ink-faint);
      margin-top: 0.2rem;
    }
    .result-card .rc-desc {
      font-family: 'EB Garamond', serif;
      font-size: 0.82rem;
      color: var(--ink-light);
      line-height: 1.4;
      margin-top: 0.45rem;
    }
    .result-card.best {
      background: var(--accent-light);
    }
    .result-card.best .rc-val { color: var(--accent); }
    .result-card.hard {
      background: var(--red-light);
    }
    .result-card.hard .rc-val { color: var(--red); }
    .result-card.mid .rc-val { color: var(--orange); }

    .metric-cell {
      font-family: 'Source Sans 3', sans-serif !important;
      font-size: 0.86rem !important;
      font-weight: 700;
    }
    .metric-cell.high {
      background: #ecf8ee !important;
      color: var(--green) !important;
    }
    .metric-cell.medium {
      background: #fff6e8 !important;
      color: var(--orange) !important;
    }
    .metric-cell.low {
      background: #fff1f1 !important;
      color: var(--red) !important;
    }
    .metric-cell.mixed {
      background: #edf3fd !important;
      color: var(--accent) !important;
    }
    .metric-note {
      display: block;
      margin-top: 0.15rem;
      font-size: 0.77rem;
      font-weight: 400;
      color: var(--ink-light);
    }

    .perp-section {
      margin: 1.4rem 0;
    }
    .perp-group {
      margin-bottom: 1.25rem;
    }
    .perp-group-title {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--ink-mid);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.45rem;
    }
    .perp-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.3rem;
    }
    .perp-row-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.67rem;
      color: var(--ink-faint);
      width: 5.5rem;
      text-align: right;
      flex-shrink: 0;
    }
    .perp-bar-outer {
      flex: 1;
      background: #efefef;
      border-radius: 3px;
      overflow: hidden;
      height: 15px;
    }
    .perp-bar-inner {
      height: 100%;
      border-radius: 3px;
    }
    .perp-bar-inner.inp { background: #d6e4f7; }
    .perp-bar-inner.pred { background: var(--accent); }
    .perp-bar-inner.base { background: #bbb; }
    .perp-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.67rem;
      color: var(--ink-light);
      white-space: nowrap;
    }
    .perp-delta {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      padding-left: 6.8rem;
      margin-top: 0.15rem;
    }
    .perp-delta.down { color: var(--green); }
    .perp-delta.up { color: var(--orange); }

    .checkpoint-flow {
      display: grid;
      gap: 0.85rem;
      margin: 1.25rem 0 1.6rem;
    }
    .checkpoint-source,
    .checkpoint-card,
    .diagnostic-card {
      border: 1px solid var(--rule);
      border-radius: 10px;
      background: #fff;
      padding: 0.95rem 1rem;
    }
    .checkpoint-source.good {
      background: linear-gradient(180deg, #fbfefb 0%, #f4fbf4 100%);
      border-color: #d7e8d9;
    }
    .checkpoint-source.bad {
      background: linear-gradient(180deg, #fffdfd 0%, #fff7f7 100%);
      border-color: #ead6d6;
    }
    .checkpoint-source-label,
    .checkpoint-stage {
      display: block;
