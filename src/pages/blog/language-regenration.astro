            <text x="445" y="90" text-anchor="middle" font-size="11" font-style="italic" fill="var(--orange)">obl · 3</text>
            <text x="60" y="182" text-anchor="middle" font-size="15" fill="var(--ink)">The</text>
            <text x="170" y="182" text-anchor="middle" font-size="15" fill="var(--ink)">cat</text>
            <text x="280" y="182" text-anchor="middle" font-size="15" font-weight="700" fill="var(--ink)">sat</text>
            <text x="390" y="182" text-anchor="middle" font-size="15" fill="var(--ink)">on</text>
            <text x="500" y="182" text-anchor="middle" font-size="15" fill="var(--ink)">the</text>
            <text x="610" y="182" text-anchor="middle" font-size="15" fill="var(--ink)">mat</text>
            <text x="60" y="200" text-anchor="middle" font-size="10" fill="var(--ink-faint)">1</text>
